# Public site configuration (safe to commit — nothing secret here).
# Change this to your real domain before deploying. No trailing slash.
VITE_SITE_URL=https://www.alwarselfdrivecar.com

# Web3Forms access key (https://web3forms.com). Every booking form e-mails the request to the
# inbox this key was created for, and opens WhatsApp with the same details. The key is public
# by design (it can only send to that one inbox), so it is fine to commit. To change the
# receiving inbox, create a new key for that address at web3forms.com and paste it here.
# Leave empty to send bookings through WhatsApp only.
VITE_WEB3FORMS_KEY=204c9c0d-ebbe-494c-8f39-262c791ac2e2
